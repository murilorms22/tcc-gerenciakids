    {
      "name": "2. Segurança e Controle de Acesso (401, 403, Mass Assignment)",
      "item": [
        {
          "name": "2.1 Acesso sem Token JWT -> 401 Unauthorized",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Bloqueia acesso anônimo com 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/alunos",
              "host": ["{{baseUrl}}"],
              "path": ["alunos"]
            }
          }
        },
        {
          "name": "2.2 Tentativa de Mass Assignment no Registro (role=ADMIN) -> 400 Bad Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Rejeita propriedade não permitida role com 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Invasor Teste\",\n  \"email\": \"invasor@escola.com\",\n  \"senha\": \"Senha1234\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "2.3 Validação de Senha Fraca no Registro (< 8 chars) -> 400 Bad Request",
          "event": [
