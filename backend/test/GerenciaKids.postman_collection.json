    {
      "name": "1. Autenticação e Perfis (JWT Stateful)",
      "item": [
        {
          "name": "1.1 Login DIRECAO (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Retorna access_token e role DIRECAO dentro de data', function () {",
                  "    pm.expect(json.data).to.have.property('access_token');",
                  "    pm.expect(json.data.user.role).to.eql('DIRECAO');",
                  "});",
                  "if (json.data && json.data.access_token) {",
                  "    pm.collectionVariables.set('direcao_token', json.data.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"direcao@escola.com\",\n  \"senha\": \"Senha123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
