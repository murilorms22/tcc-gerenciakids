        },
        {
          "name": "2.6 RESPONSAVEL listando Alunos -> Retorna apenas próprios filhos (Isolamento LGPD)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Retorna apenas alunos vinculados ao responsável logado', function () {",
                  "    pm.expect(json.data).to.be.an('array');",
                  "    json.data.forEach(a => {",
                  "        pm.expect(a.responsavel.nome).to.eql('Fernanda Souza Martins');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{responsavel_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/alunos",
              "host": ["{{baseUrl}}"],
              "path": ["alunos"]
            }
          }
        },
