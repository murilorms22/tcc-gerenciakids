    {
      "name": "3. Gestão de Alunos, Criptografia AES-256-GCM e Auditoria LGPD",
      "item": [
        {
          "name": "3.1 DIRECAO cria Aluno com Ficha Médica Sensível (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "    pm.collectionVariables.set('novo_aluno_id', String(json.data.id));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{direcao_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Pedro Henrique Martins\",\n  \"data_nascimento\": \"2022-11-10\",\n  \"genero\": \"Masculino\",\n  \"endereco\": \"Rua Augusta, 789 - São Paulo/SP\",\n  \"tipo_sanguineo\": \"O-\",\n  \"alergias\": \"Alergia severa a dipirona e frutos do mar.\",\n  \"observacoes\": \"Portador de asma leve; bombinha na mochila.\",\n  \"peso\": 14.1,\n  \"altura\": 92,\n  \"turmaId\": 1,\n  \"responsavelId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/alunos",
              "host": ["{{baseUrl}}"],
              "path": ["alunos"]
            }
          }
        },
        {
          "name": "3.2 Verificar Criptografia AES-256-GCM no Banco (iv:authTag:ciphertext)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Campos médicos estão criptografados em formato iv:authTag:ciphertext', function () {",
                  "    pm.expect(json.data.alergias).to.match(/^[0-9a-f]{24}:[0-9a-f]{32}:[0-9a-f]+$/i);",
                  "    pm.expect(json.data.tipo_sanguineo).to.match(/^[0-9a-f]{24}:[0-9a-f]{32}:[0-9a-f]+$/i);",
                  "    pm.expect(json.data.observacoes).to.match(/^[0-9a-f]{24}:[0-9a-f]{32}:[0-9a-f]+$/i);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{direcao_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/alunos/{{novo_aluno_id}}/criptografia",
              "host": ["{{baseUrl}}"],
              "path": ["alunos", "{{novo_aluno_id}}", "criptografia"]
            }
          }
        },
        {
          "name": "3.3 PROFESSOR registra Chamada (PATCH /alunos/:id/chamada)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Incrementa contador de faltas do aluno', function () {",
                  "    pm.expect(json.data.faltas).to.be.at.least(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{professor_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"incrementar\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/alunos/{{novo_aluno_id}}/chamada",
              "host": ["{{baseUrl}}"],
              "path": ["alunos", "{{novo_aluno_id}}", "chamada"]
            }
          }
        },
        {
          "name": "3.4 DIRECAO consulta Trilha de Auditoria LGPD (GET /audit-logs)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Lista logs de auditoria registrados automaticamente', function () {",
                  "    pm.expect(json.data).to.be.an('array');",
                  "    pm.expect(json.data.length).to.be.greaterThan(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{direcao_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/audit-logs",
              "host": ["{{baseUrl}}"],
              "path": ["audit-logs"]
            }
          }
        }
      ]
    }
