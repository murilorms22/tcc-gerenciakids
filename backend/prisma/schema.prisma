generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  RESPONSAVEL
  PROFESSOR
  DIRECAO
  ADMIN
}

enum PrioridadeAviso {
  NORMAL
  URGENTE
}

enum StatusAviso {
  PENDENTE
  APROVADO
  REJEITADO
}

model User {
  id          Int          @id @default(autoincrement())
  nome        String
  email       String       @unique
  senha       String
  role        Role         @default(RESPONSAVEL)
  tokens      Token[]
  responsavel Responsavel?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("users")
}

model Token {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(512)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("tokens")
}

model Turma {
  id         Int         @id @default(autoincrement())
  nome       String
  turno      String
  ano_letivo Int
  alunos     Aluno[]
  atividades Atividade[]
  avisos     Aviso[]

  @@map("turmas")
}

model Responsavel {
  id       Int     @id @default(autoincrement())
  nome     String
  cpf      String  @unique
  telefone String
  userId   Int?    @unique
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  alunos   Aluno[]

  @@map("responsaveis")
}

model Aluno {
  id              Int         @id @default(autoincrement())
  nome            String
  data_nascimento String
  genero          String?
  endereco        String?
  foto_perfil_url String?     @db.LongText
  tipo_sanguineo  String?     @db.Text
  alergias        String?     @db.Text
  observacoes     String?     @db.Text
  peso            Float?
  altura          Float?
  faltas          Int         @default(0)
  turmaId         Int
  turma           Turma       @relation(fields: [turmaId], references: [id], onDelete: Restrict)
  responsavelId   Int
  responsavel     Responsavel @relation(fields: [responsavelId], references: [id], onDelete: Restrict)
  pareceres       Parecer[]

  @@index([turmaId])
  @@index([responsavelId])
  @@map("alunos")
}

model Parecer {
  id            Int      @id @default(autoincrement())
  titulo        String
  periodo       String   @default("1º Semestre / 2026")
  conteudo      String   @db.Text
  professorNome String
  alunoId       Int
  aluno         Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([alunoId])
  @@map("pareceres")
}

model Atividade {
  id        Int     @id @default(autoincrement())
  titulo    String
  descricao String? @db.Text
  horario   String
  sala      String
  concluida Boolean @default(false)
  turmaId   Int
  turma     Turma   @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@index([turmaId])
  @@map("atividades")
}

model Aviso {
  id         Int             @id @default(autoincrement())
  titulo     String
  conteudo   String          @db.Text
  prioridade PrioridadeAviso @default(NORMAL)
  status     StatusAviso     @default(APROVADO)
  autorNome  String
  turmaId    Int?
  turma      Turma?          @relation(fields: [turmaId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())

  @@index([turmaId])
  @@map("avisos")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  userEmail  String?
  userRole   String?
  acao       String
  entidade   String
  entidadeId String?
  detalhes   String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([entidade])
  @@index([userId])
  @@map("audit_logs")
}

